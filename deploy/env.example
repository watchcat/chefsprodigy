# /srv/chefslegacy/.env: platform-level settings read by hubctl and by docker compose.
# Copy this file there, fill it in, then run `deploy/hubctl init`.

# Zone served by this VPS. Hubs become <name>.DOMAIN; the apex is the platform's page.
DOMAIN=chefslegacy.com

# Hub image. Tags v* of this repo publish ghcr.io/watchcat/chefsprodigy:<version>;
# change the tag and run `hubctl upgrade all` to roll hubs forward.
HUB_IMAGE=ghcr.io/watchcat/chefsprodigy:0.1.0

# origin: Caddy serves HTTPS with the Cloudflare Origin CA certificate in caddy/certs/
#         (origin.pem + origin.key); Cloudflare SSL mode "Full (strict)".
# off:    plain HTTP on HTTP_PORT, for local tests only.
TLS_MODE=origin
HTTP_PORT=80
HTTPS_PORT=443

# rclone remote and bucket for backups (`rclone config`, S3-compatible R2 endpoint).
# Set a 30-day lifecycle rule on the bucket.
R2_REMOTE=r2:chefslegacy-backups

# Per-hub resource caps (docs/SPEC-hosted-platform.md section 7).
HUB_MEM_LIMIT=128m
HUB_CPUS=0.5

# Phase 0: hubs call the model vendor directly. hubctl copies these into each new hub's
# .env; the llm-gateway (RN-66) replaces them with a per-hub gateway token later.
LLM_MODEL=minimax/MiniMax-M3
MINIMAX_API_KEY=
