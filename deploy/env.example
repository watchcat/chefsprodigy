# /srv/chefslegacy/.env: platform-level settings read by hubctl and by docker compose.
# Copy this file there, fill it in, then run `deploy/hubctl init`.

# Zone served by this VPS. Hubs become <name>.DOMAIN; the apex is the platform's page.
DOMAIN=chefslegacy.com

# Hub image. Tags v* of this repo publish ghcr.io/watchcat/chefsprodigy:<version>;
# change the tag and run `hubctl upgrade all` to roll hubs forward.
HUB_IMAGE=ghcr.io/watchcat/chefsprodigy:0.1.0

# origin: Caddy serves HTTPS with the Cloudflare Origin CA certificate in caddy/certs/
#         (origin.pem + origin.key); Cloudflare SSL mode "Full (strict)".
# off:    plain HTTP on HTTP_PORT, for local tests only.
TLS_MODE=origin
HTTP_PORT=80
HTTPS_PORT=443

# rclone remote and bucket for backups (`rclone config`, S3-compatible R2 endpoint).
# Set a 30-day lifecycle rule on the bucket.
R2_REMOTE=r2:chefslegacy-backups

# Per-hub resource caps (docs/SPEC-hosted-platform.md section 7).
HUB_MEM_LIMIT=128m
HUB_CPUS=0.5

# Model access. LLM_MODEL is copied into every new hub's .env. MINIMAX_API_KEY is the
# vendor key: with the gateway enabled below it stays here (the gateway holds it) and
# hubs get a per-hub gateway token instead; without the gateway hubctl copies it into
# each new hub's .env (phase 0).
LLM_MODEL=minimax/MiniMax-M3
MINIMAX_API_KEY=

# llm-gateway (phase 1). Set an admin token to enable it: hubctl then registers every
# new hub at the gateway (POST /admin/hubs) and points the hub at
# http://llm-gateway:8080/anthropic with its hub token. The admin API is published on
# 127.0.0.1:GATEWAY_ADMIN_PORT only. Generate a token with `openssl rand -hex 32`.
GATEWAY_ADMIN_TOKEN=
GATEWAY_ADMIN_PORT=8090
# Encrypts hubs' own vendor keys (BYOK) at rest; without it BYOK is disabled. Losing it
# loses the stored keys (hubs re-enter them). `openssl rand -hex 32`.
GATEWAY_MASTER_KEY=
