# hubctl settings. Copy to /srv/chefslegacy/.env (or $HUBCTL_ROOT/.env, or pass --root).
# Everything else lives in the cluster; see deploy/README.md.

# Hubs are served as <name>.<DOMAIN>; the DNS wildcard points at this node through Cloudflare.
DOMAIN=chefslegacy.com

# Image every hub runs. Pin a release tag; `hubctl upgrade all` rolls hubs to a new value.
HUB_IMAGE=ghcr.io/watchcat/chefsprodigy:latest

# origin: Traefik serves the Cloudflare Origin CA certificate from Secret chefs-origin-tls in
#         kube-system (TLS between Cloudflare and the node, http redirected to https).
# off:    plain http on the `web` entrypoint, http:// public URLs; for local k3d tests only.
TLS_MODE=origin

# Per-hub resources (defaults shown; local-path volumes are not quota-enforced).
#HUB_STORAGE=2Gi
#HUB_MEM_LIMIT=128Mi
#HUB_CPU_LIMIT=500m
#HUB_MEM_REQUEST=32Mi
#HUB_CPU_REQUEST=50m

# Nightly backups: every hub's /api/v1/export archive goes to Cloudflare R2 with rclone.
# Leave the R2_* values empty to keep the CronJob but skip the upload.
#BACKUP_SCHEDULE=17 3 * * *
#R2_BUCKET=chefslegacy-backups
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=

# Model access copied into every new hub's Secret (phase 0). The llm-gateway of a later
# story replaces the vendor key with a per-hub token; existing hubs keep what they were given.
#LLM_MODEL=minimax/MiniMax-M3
#MINIMAX_API_KEY=
