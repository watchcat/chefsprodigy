# hubctl settings. Copy to /srv/chefslegacy/.env (or $HUBCTL_ROOT/.env, or pass --root).
# Everything else lives in the cluster; see deploy/README.md.

# Hubs are served as <name>.<DOMAIN>; the DNS wildcard points at this node through Cloudflare.
DOMAIN=chefslegacy.com

# Image every hub runs. Pin a release tag; `hubctl upgrade all` rolls hubs to a new value.
HUB_IMAGE=ghcr.io/watchcat/chefsprodigy:latest

# origin: Traefik serves the Cloudflare Origin CA certificate from Secret chefs-origin-tls in
#         chefs-system, copied into chefs-hubs by `hubctl init` (TLS between Cloudflare and
#         the node, http redirected to https for every host on the node).
# off:    plain http on the `web` entrypoint, http:// public URLs; for local k3d tests only.
TLS_MODE=origin

# Per-hub resources (defaults shown; local-path volumes are not quota-enforced).
#HUB_STORAGE=2Gi
#HUB_MEM_LIMIT=128Mi
#HUB_CPU_LIMIT=500m
#HUB_MEM_REQUEST=32Mi
#HUB_CPU_REQUEST=50m

# Nightly backups: every hub's /api/v1/export archive goes to Cloudflare R2 with rclone.
# Leave the R2_* values empty to keep the CronJob but skip the upload.
#BACKUP_SCHEDULE=17 3 * * *
#R2_BUCKET=chefslegacy-backups
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=

# Model access. With a vendor key here, `hubctl init` runs the llm-gateway in chefs-system
# and keeps the keys there (Secret llm-gateway-env); `hubctl create` registers every hub at
# the gateway and gives it a per-hub token plus the gateway's address instead of the key.
# The gateway serves MiniMax and Anthropic models (Messages format); usage is recorded per
# hub and day (`hubctl usage`). LLM_GATEWAY=off, or a model from another vendor, copies the
# settings below into each hub's Secret instead (direct vendor access).
#LLM_MODEL=minimax/MiniMax-M3
#MINIMAX_API_KEY=
#ANTHROPIC_API_KEY=
#LLM_GATEWAY=on
# Optional gateway settings: upstream overrides (MiniMax China: https://api.minimaxi.com/anthropic),
# an admin token for its /admin API, its volume and memory limit.
#MINIMAX_ANTHROPIC_API_BASE=
#ANTHROPIC_API_BASE=
#GATEWAY_ADMIN_TOKEN=
#GATEWAY_STORAGE=1Gi
#GATEWAY_MEM_LIMIT=64Mi
# Gateway quotas, cache and BYOK (deploy/README.md section 3). Every hub starts on the free
# tier (30 model requests a day for its first 3 days, then 10; at most 150 requests or 100
# cents a month); GATEWAY_ADMIN_TOKEN above enables the admin API that changes a hub's limits
# and sets model prices. GATEWAY_MASTER_KEY encrypts hub owners' own vendor keys (BYOK) in
# gateway.db; without it BYOK is off, and replacing it makes stored keys unreadable (those hubs
# fall back to the platform key until their keys are stored again). Generate it, and the admin
# token, with `openssl rand -hex 32`. Replies to deterministic requests (temperature 0) are
# cached for GATEWAY_CACHE_TTL_DAYS, keeping at most GATEWAY_CACHE_MAX_ENTRIES (defaults shown).
#GATEWAY_MASTER_KEY=
#GATEWAY_CACHE_TTL_DAYS=30
#GATEWAY_CACHE_MAX_ENTRIES=10000

# Platform on the apex (DOMAIN): hub registry, federation poller and search API, deployed
# by `hubctl init`; `hubctl create` registers each hub with it. Its /admin API stays off
# (503) without a token, and the apex Ingress never routes /admin either way. Poll timing
# defaults: every 600 s plus up to 60 s jitter, failing hubs backed off up to 3600 s.
#PLATFORM_ADMIN_TOKEN=
#PLATFORM_POLL_INTERVAL_SECS=600
#PLATFORM_POLL_JITTER_SECS=60
#PLATFORM_BACKOFF_MAX_SECS=3600
#PLATFORM_HTTP_TIMEOUT_SECS=10
#PLATFORM_STORAGE=1Gi
#PLATFORM_MEM_LIMIT=128Mi
