def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hubctl", description=__doc__.split("\n\n")[0])
    parser.add_argument("--root", default=os.environ.get("HUBCTL_ROOT", DEFAULT_ROOT),
                        help=f"directory holding .env (default: $HUBCTL_ROOT or {DEFAULT_ROOT})")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="namespaces, network policies, Traefik config, backup CronJob, llm-gateway")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("create", help="create (or repair) a hub and wait for it")
    p.add_argument("name")
    p.add_argument("--chef", help="display name of the chef (default: the hub name)")
    p.add_argument("--author-did", help="NODE_AUTHOR_DID for the federation manifest")
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("remove", help="delete a hub's workload; its volume stays unless --purge")
    p.add_argument("name")
    p.add_argument("--purge", action="store_true", help="also delete the hub's PersistentVolumeClaim")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("list", help="hubs and their URLs")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("status", help="pod state of every hub")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("rotate-key", help="replace a hub's owner key and restart it")
    p.add_argument("name")
    p.set_defaults(func=cmd_rotate_key)

    p = sub.add_parser("gateway-token", help="issue a hub a new llm-gateway token and restart it")
    p.add_argument("name")
    p.set_defaults(func=cmd_gateway_token)

    p = sub.add_parser("usage", help="model requests and tokens per hub and day, from the llm-gateway")
    p.add_argument("name", nargs="?", help="only this hub")
    p.add_argument("--from", dest="since", metavar="YYYY-MM-DD", help="first day (inclusive)")
    p.add_argument("--to", dest="until", metavar="YYYY-MM-DD", help="last day (inclusive)")
    p.set_defaults(func=cmd_usage)

    p = sub.add_parser("login-link", help="mint a 10-minute magic sign-in link for a hub's owner")
    p.add_argument("name")
    p.set_defaults(func=cmd_login_link)

    p = sub.add_parser("backup", help="run the backup CronJob now for one hub or all")
    p.add_argument("name", help="hub name or 'all'")
    p.add_argument("--timeout", default="600s")
    p.set_defaults(func=cmd_backup)

    p = sub.add_parser("restore", help="replace a hub's data with a backup archive")
    p.add_argument("name")
    p.add_argument("archive")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("upgrade", help="roll the gateway and the hubs to the image in .env, one by one")
    p.add_argument("name", nargs="?", default="all")
    p.set_defaults(func=cmd_upgrade)

    p = sub.add_parser("render", help="print the manifests hubctl would apply (a hub name or 'all') as YAML")
    p.add_argument("name", nargs="?", default="all", help="hub name or 'all' (default)")
    p.add_argument("--json", action="store_true", help="print a JSON List instead of YAML documents")
    p.add_argument("--reference", metavar="DIR",
                   help="write the checked-in reference set (deploy/k8s) with example settings; no .env or kubectl needed")
    p.set_defaults(func=cmd_render)
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    cfg = Config(Path(args.root).expanduser())
    kube = Kube()
    try:
        return int(args.func(cfg, kube, args) or 0)
    except HubctlError as e:
        print(f"hubctl: {e}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as e:
        detail = (e.stderr or e.stdout or "").strip()
        print(f"hubctl: {' '.join(map(str, e.cmd))} failed with exit status {e.returncode}: {detail}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
