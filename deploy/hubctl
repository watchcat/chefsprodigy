def hub_manifests(cfg: Config, name: str, values: Dict[str, str]) -> List[dict]:
    """Secret + StatefulSet + Service + Ingress for one hub (spec 5.6)."""
    labels = {"app": "hub", "hub": name}
    sts_name = f"hub-{name}"
    annotations = {
        "traefik.ingress.kubernetes.io/router.entrypoints": "websecure" if cfg.tls else "web",
        "traefik.ingress.kubernetes.io/router.middlewares": MIDDLEWARES,
    }
    ingress_spec: dict = {
        "rules": [{
            "host": cfg.host(name),
            "http": {"paths": [{"path": "/", "pathType": "Prefix",
                                "backend": {"service": {"name": sts_name, "port": {"number": 8080}}}}]},
        }],
    }
    if cfg.tls:
        ingress_spec["tls"] = [{"hosts": [cfg.host(name)]}]
    return [
        {
            "apiVersion": "v1", "kind": "Secret",
            "metadata": meta(f"{sts_name}-env", NS_HUBS, labels),
            "type": "Opaque",
            "stringData": dict(values),
        },
        {
            "apiVersion": "apps/v1", "kind": "StatefulSet",
            "metadata": meta(sts_name, NS_HUBS, labels),
            "spec": {
                "serviceName": sts_name,
                "replicas": 1,
                "selector": {"matchLabels": labels},
                "template": {
                    "metadata": {"labels": labels},
                    "spec": {
                        "automountServiceAccountToken": False,
                        "securityContext": {
                            "runAsNonRoot": True, "runAsUser": HUB_UID, "runAsGroup": HUB_UID,
                            "fsGroup": HUB_UID, "seccompProfile": {"type": "RuntimeDefault"},
                        },
                        "containers": [{
                            "name": "node",
                            "image": cfg.hub_image,
                            "args": ["serve"],
                            "env": [{"name": "TOKIO_WORKER_THREADS", "value": "2"}],
                            "envFrom": [{"secretRef": {"name": f"{sts_name}-env"}}],
                            "ports": [{"containerPort": 8080, "name": "http"}],
                            "volumeMounts": [
                                {"name": "data", "mountPath": "/data"},
                                {"name": "tmp", "mountPath": "/tmp"},
                            ],
                            "resources": {
                                "requests": {"cpu": cfg.hub_cpu_request, "memory": cfg.hub_mem_request},
                                "limits": {"cpu": cfg.hub_cpu_limit, "memory": cfg.hub_mem_limit},
                            },
                            "securityContext": {
                                "readOnlyRootFilesystem": True,
                                "allowPrivilegeEscalation": False,
                                "capabilities": {"drop": ["ALL"]},
                            },
                            "readinessProbe": {"httpGet": {"path": "/api/v1/health", "port": "http"}, "periodSeconds": 10},
                            "livenessProbe": {"httpGet": {"path": "/api/v1/health", "port": "http"},
                                              "periodSeconds": 30, "failureThreshold": 3},
                        }],
                        "volumes": [{"name": "tmp", "emptyDir": {}}],
                    },
                },
                "volumeClaimTemplates": [{
                    "metadata": {"name": "data"},
                    "spec": {"accessModes": ["ReadWriteOnce"], "storageClassName": "local-path",
                             "resources": {"requests": {"storage": cfg.hub_storage}}},
                }],
            },
        },
        {
            "apiVersion": "v1", "kind": "Service",
            "metadata": meta(sts_name, NS_HUBS, labels),
            "spec": {"selector": labels, "ports": [{"name": "http", "port": 8080, "targetPort": "http"}]},
        },
        {
            "apiVersion": "networking.k8s.io/v1", "kind": "Ingress",
            "metadata": meta(sts_name, NS_HUBS, labels, annotations),
            "spec": ingress_spec,
        },
    ]


def gateway_manifests(cfg: Config, values: Dict[str, str]) -> List[dict]:
    """Secret + PVC + Deployment + Service + ingress NetworkPolicy for the llm-gateway (spec 5.2).
    Same image as the hubs; one replica with Recreate, because gateway.db is SQLite on a
    ReadWriteOnce volume. A checksum of the Secret on the pod template restarts the gateway
    when a vendor key in .env changes."""
    labels = {"app": GATEWAY}
    checksum = hashlib.sha256(json.dumps(values, sort_keys=True).encode()).hexdigest()[:16]
    return [
        {
            "apiVersion": "v1", "kind": "Secret",
            "metadata": meta(f"{GATEWAY}-env", NS_SYSTEM, labels),
            "type": "Opaque",
            "stringData": dict(values),
        },
        {
            "apiVersion": "v1", "kind": "PersistentVolumeClaim",
            "metadata": meta(f"{GATEWAY}-data", NS_SYSTEM, labels),
            "spec": {"accessModes": ["ReadWriteOnce"], "storageClassName": "local-path",
                     "resources": {"requests": {"storage": cfg.gateway_storage}}},
        },
        {
            "apiVersion": "apps/v1", "kind": "Deployment",
            "metadata": meta(GATEWAY, NS_SYSTEM, labels),
            "spec": {
                "replicas": 1,
                "strategy": {"type": "Recreate"},
                "selector": {"matchLabels": labels},
                "template": {
                    "metadata": {"labels": labels, "annotations": {"chefsprodigy/env-checksum": checksum}},
                    "spec": {
                        "automountServiceAccountToken": False,
                        "securityContext": {
                            "runAsNonRoot": True, "runAsUser": HUB_UID, "runAsGroup": HUB_UID,
                            "fsGroup": HUB_UID, "seccompProfile": {"type": "RuntimeDefault"},
                        },
                        "containers": [{
                            "name": "gateway",
                            "image": cfg.hub_image,
                            "command": [GATEWAY_BIN],
                            "args": ["serve"],
                            "env": [
                                {"name": "GATEWAY_PORT", "value": "8080"},
                                {"name": "GATEWAY_DATA_DIR", "value": "/data"},
                                {"name": "TOKIO_WORKER_THREADS", "value": "2"},
                            ],
                            "envFrom": [{"secretRef": {"name": f"{GATEWAY}-env"}}],
                            "ports": [{"containerPort": 8080, "name": "http"}],
                            "volumeMounts": [
                                {"name": "data", "mountPath": "/data"},
                                {"name": "tmp", "mountPath": "/tmp"},
                            ],
                            "resources": {
                                "requests": {"cpu": "50m", "memory": "24Mi"},
                                "limits": {"cpu": "500m", "memory": cfg.gateway_mem_limit},
                            },
                            "securityContext": {
                                "readOnlyRootFilesystem": True,
                                "allowPrivilegeEscalation": False,
                                "capabilities": {"drop": ["ALL"]},
                            },
                            "readinessProbe": {"httpGet": {"path": "/health", "port": "http"}, "periodSeconds": 10},
                            "livenessProbe": {"httpGet": {"path": "/health", "port": "http"},
                                              "periodSeconds": 30, "failureThreshold": 3},
                        }],
                        "volumes": [
                            {"name": "data", "persistentVolumeClaim": {"claimName": f"{GATEWAY}-data"}},
                            {"name": "tmp", "emptyDir": {}},
                        ],
                    },
                },
            },
        },
        {
            "apiVersion": "v1", "kind": "Service",
            "metadata": meta(GATEWAY, NS_SYSTEM, labels),
            "spec": {"selector": labels, "ports": [{"name": "http", "port": 8080, "targetPort": "http"}]},
        },
        {
            "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
            "metadata": meta(f"{GATEWAY}-ingress", NS_SYSTEM),
            "spec": {
                "podSelector": {"matchLabels": labels},
                "policyTypes": ["Ingress"],
                "ingress": [{
                    "from": [{
                        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": NS_HUBS}},
                        "podSelector": {"matchLabels": {"app": "hub"}},
                    }],
                    "ports": [{"protocol": "TCP", "port": 8080}],
                }],
            },
        },
    ]


def restore_pod(name: str) -> dict:
    return {
        "apiVersion": "v1", "kind": "Pod",
        "metadata": meta(f"hub-{name}-restore", NS_HUBS, {"app": "hub-restore", "hub": name}),
        "spec": {
            "restartPolicy": "Never",
            "containers": [{
                "name": "restore", "image": RESTORE_IMAGE,
                "command": ["sh", "-c", "sleep 3600"],
                "volumeMounts": [{"name": "data", "mountPath": "/data"}],
            }],
            "volumes": [{"name": "data", "persistentVolumeClaim": {"claimName": f"data-hub-{name}-0"}}],
        },
    }


# ----------------------------------------------------------------------------- hub state


def hub_values(cfg: Config, kube: Kube, name: str) -> Dict[str, str]:
    return secret_values(kube.get("secret", f"hub-{name}-env", NS_HUBS))


def hub_names(kube: Kube) -> List[str]:
    secrets_ = kube.list("secret", NS_HUBS, "app=hub")
    return sorted(s["metadata"].get("labels", {}).get("hub", "") for s in secrets_ if s["metadata"].get("labels", {}).get("hub"))


def wait_for_traefik_crds(kube: Kube) -> bool:
    """On a fresh node k3s installs Traefik's CRDs through a Helm job a minute or so after
    boot. `kubectl wait` fails at once while the CRD does not exist, so retry until the deadline."""
    deadline = time.monotonic() + CRD_WAIT_SECONDS
    while True:
        if kube.wait("condition=established", "crd/middlewares.traefik.io", NS_TRAEFIK, "30s"):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(5)


def ensure_base(cfg: Config, kube: Kube) -> None:
    cfg.require()
    if cfg.tls and kube.get("secret", ORIGIN_TLS_SECRET, NS_TRAEFIK) is None:
        raise HubctlError(
            f"TLS_MODE=origin needs the Cloudflare Origin CA certificate as Secret {ORIGIN_TLS_SECRET} in "
            f"{NS_TRAEFIK} (kubectl -n {NS_TRAEFIK} create secret tls {ORIGIN_TLS_SECRET} --cert=origin.pem "
            "--key=origin.key); see deploy/README.md, or set TLS_MODE=off for a local test"
        )
    kube.apply(namespaces())
    if not wait_for_traefik_crds(kube):
        raise HubctlError(
            "Traefik's CRDs (middlewares.traefik.io) are not installed yet; k3s may still be installing "
            f"Traefik: kubectl -n {NS_TRAEFIK} get jobs (helm-install-traefik-crd, helm-install-traefik), "
            "then run this command again"
        )
    kube.apply(network_policies() + traefik_config(cfg) + backup_manifests(cfg))
    if cfg.gateway_enabled:
        kube.apply(gateway_manifests(cfg, cfg.gateway_env()))


# ----------------------------------------------------------------------------- gateway


def gateway_cli(kube: Kube, *args: str, check: bool = True) -> subprocess.CompletedProcess:
    """Run the llm-gateway CLI inside its pod: it opens the same gateway.db as the server."""
    return kube.run("exec", f"deploy/{GATEWAY}", "-n", NS_SYSTEM, "--", GATEWAY_BIN, *args, check=check)


def gateway_installed(kube: Kube) -> bool:
    return kube.get("deployment", GATEWAY, NS_SYSTEM) is not None


def issue_gateway_token(kube: Kube, name: str) -> str:
    """Register the hub at the gateway, or give it a new token (the old one stops working)."""
    if not kube.rollout_status(GATEWAY, NS_SYSTEM, "120s", kind="deployment"):
        raise HubctlError(f"{GATEWAY} is not ready; kubectl -n {NS_SYSTEM} logs deploy/{GATEWAY}")
    out = gateway_cli(kube, "add-hub", name, "--rotate", "--json").stdout.strip().splitlines()
    try:
        return json.loads(out[-1])["token"]
    except (IndexError, ValueError, KeyError) as e:
        raise HubctlError(f"unexpected answer from {GATEWAY} add-hub: {e}") from None


def use_gateway_token(values: Dict[str, str], token: str) -> None:
    """Point both Messages-format vendors rig knows (MiniMax, Anthropic) at the gateway."""
    for key in HUB_DIRECT_KEYS:
        values.pop(key, None)
    values["MINIMAX_ANTHROPIC_API_BASE"] = GATEWAY_HUB_BASE
    values["MINIMAX_API_KEY"] = token
    values["ANTHROPIC_BASE_URL"] = GATEWAY_HUB_BASE
    values["ANTHROPIC_API_KEY"] = token


def wire_model_access(cfg: Config, kube: Kube, name: str, values: Dict[str, str]) -> None:
    on_gateway = values.get("MINIMAX_ANTHROPIC_API_BASE") == GATEWAY_HUB_BASE and bool(values.get("MINIMAX_API_KEY"))
    if cfg.gateway_enabled:
        for key in HUB_ENV_PASSTHROUGH_GATEWAY:
            if key not in values and cfg.env.get(key):
                values[key] = cfg.env[key]
        token = values["MINIMAX_API_KEY"] if on_gateway else issue_gateway_token(kube, name)
        use_gateway_token(values, token)
        return
    if on_gateway:  # the gateway was switched off: back to direct vendor access
        for key in HUB_DIRECT_KEYS:
            values.pop(key, None)
    for key in HUB_ENV_PASSTHROUGH:
        if key not in values and cfg.env.get(key):
            values[key] = cfg.env[key]


def placeholder_values(cfg: Config, name: str) -> Dict[str, str]:
    """What a hub Secret looks like before `hubctl create` mints the real values."""
    values = {
        "NODE_API_KEY": "<generated by hubctl create>",
        "NODE_CHEF_NAME": name.capitalize(),
        "NODE_PUBLIC_URL": cfg.public_url(name),
        "NODE_HOST": "0.0.0.0",
        "NODE_PORT": "8080",
        "NODE_DATA_DIR": "/data",
    }
    if cfg.env.get("LLM_MODEL"):
        values["LLM_MODEL"] = cfg.env["LLM_MODEL"]
    if cfg.gateway_enabled:
        use_gateway_token(values, HUB_TOKEN_PLACEHOLDER)
    elif cfg.env.get("LLM_MODEL"):
        values["MINIMAX_API_KEY"] = "<vendor key copied from .env (LLM_GATEWAY=off)>"
    return values


REFERENCE_HUB = "jacob"


def reference_manifests(cfg: Config) -> Dict[str, str]:
    """The checked-in deploy/k8s set: one YAML file per concern, production (origin TLS) shape."""
    header = (
        f"# Generated by `deploy/hubctl render --reference deploy/k8s` for DOMAIN={cfg.domain}, "
        f"TLS_MODE={cfg.tls_mode}.\n"
        "# `hubctl init` and `hubctl create` apply these same objects; edit deploy/hubctl, not this file.\n"
        "# deploy/tests fails when the checked-in copy drifts from hubctl.\n"
    )
    hub_header = header + f"# Example hub `{REFERENCE_HUB}`: what `hubctl render {REFERENCE_HUB}` prints before the hub exists.\n"
    return {
        "namespaces.yaml": yaml_documents(namespaces(), header),
        "network-policies.yaml": yaml_documents(network_policies(), header),
        "traefik-config.yaml": yaml_documents(traefik_config(cfg), header),
        "backup-cronjob.yaml": yaml_documents(backup_manifests(cfg), header),
        "llm-gateway.yaml": yaml_documents(gateway_manifests(cfg, cfg.gateway_placeholder_env()), header),
        "hub.example.yaml": yaml_documents(
            hub_manifests(cfg, REFERENCE_HUB, placeholder_values(cfg, REFERENCE_HUB)), hub_header
        ),
    }


# ----------------------------------------------------------------------------- commands


def cmd_init(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    ensure_base(cfg, kube)
    print(f"cluster ready for {cfg.domain}: TLS {cfg.tls_mode}, hub image {cfg.hub_image}, "
          f"backups {'to R2 at ' + cfg.backup_schedule if cfg.r2_configured else 'without R2 (set R2_* in .env)'}")
    if cfg.gateway_enabled:
        keys = ", ".join(k for k in GATEWAY_VENDOR_KEYS if cfg.env.get(k))
        print(f"model gateway: {GATEWAY} at {GATEWAY_URL} holds {keys}; hubs get per-hub tokens")
    else:
        print("model gateway: off (LLM_GATEWAY=off or no vendor key in .env); hubs call the vendor directly")
    names = hub_names(kube)
    print(f"hubs: {', '.join(names) or 'none yet'}")
    return 0


def cmd_create(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    ensure_base(cfg, kube)
    values = hub_values(cfg, kube, name)
    new_key = "NODE_API_KEY" not in values
    values.setdefault("NODE_API_KEY", secrets.token_hex(32))
    if args.chef:
        values["NODE_CHEF_NAME"] = args.chef
    values.setdefault("NODE_CHEF_NAME", name.capitalize())
    values["NODE_PUBLIC_URL"] = cfg.public_url(name)
    if args.author_did:
        values["NODE_AUTHOR_DID"] = args.author_did
    values.setdefault("NODE_HOST", "0.0.0.0")
    values.setdefault("NODE_PORT", "8080")
    values.setdefault("NODE_DATA_DIR", "/data")
    wire_model_access(cfg, kube, name, values)
    kube.apply(hub_manifests(cfg, name, values))
    ready = kube.rollout_status(f"hub-{name}", NS_HUBS)
    print(f"hub {name} is {'up' if ready else 'not ready yet'} at {cfg.public_url(name)}")
    if new_key:
        print(f"owner key (shown once, store it safely): {values['NODE_API_KEY']}")
    url, expires = login_url(cfg, name, values["NODE_API_KEY"])
    print(f"sign-in link (valid until {fmt_time(expires)}, accepted by hubs with RN-73): {url}")
    return 0 if ready else 1


def cmd_remove(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    cfg.require()
    for kind in ("ingress", "service", "statefulset", "secret"):
        kube.delete(kind, f"hub-{name}-env" if kind == "secret" else f"hub-{name}", NS_HUBS)
    print(f"hub {name} removed; its volume data-hub-{name}-0 is kept (hubctl remove {name} --purge deletes it)")
    if gateway_installed(kube):
        result = gateway_cli(kube, "disable-hub", name, check=False)
        if result.returncode == 0:
            print(f"gateway token revoked ({result.stdout.strip()})")
        else:
            print(f"warning: could not disable {name} at {GATEWAY}: {(result.stderr or '').strip()}", file=sys.stderr)
    if args.purge:
        kube.delete("pvc", f"data-hub-{name}-0", NS_HUBS)
        print(f"volume of {name} deleted")
    return 0


def cmd_list(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    cfg.require()
    for name in hub_names(kube):
        print(f"{name:<24} {cfg.public_url(name)}")
    return 0


def pod_state(pod: Optional[dict]) -> str:
    if pod is None:
        return "no pod"
    ready = all(c.get("ready") for c in pod.get("status", {}).get("containerStatuses", []))
    return f"{pod.get('status', {}).get('phase', '?')}{' ready' if ready else ''}"


def cmd_status(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    cfg.require()
    if gateway_installed(kube):
        gw_pods = kube.pods(NS_SYSTEM, f"app={GATEWAY}")
        print(f"{GATEWAY:<24} {GATEWAY_URL:<44} {pod_state(gw_pods[0] if gw_pods else None)}")
    pods = kube.pods(NS_HUBS, "app=hub")
    by_hub = {p["metadata"].get("labels", {}).get("hub", "?"): p for p in pods}
    for name in hub_names(kube):
        print(f"{name:<24} {cfg.public_url(name):<44} {pod_state(by_hub.get(name))}")
    return 0


def cmd_rotate_key(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    cfg.require()
    values = hub_values(cfg, kube, name)
    if not values:
        raise HubctlError(f"hub {name} does not exist")
    values["NODE_API_KEY"] = secrets.token_hex(32)
    kube.apply(hub_manifests(cfg, name, values))
    kube.rollout_restart(f"hub-{name}", NS_HUBS)
    ready = kube.rollout_status(f"hub-{name}", NS_HUBS)
    print(f"hub {name} restarted with a new key ({'ready' if ready else 'not ready yet'}); sessions and MCP clients must sign in again")
    print(f"owner key (shown once, store it safely): {values['NODE_API_KEY']}")
    return 0 if ready else 1


def cmd_gateway_token(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    cfg.require()
    values = hub_values(cfg, kube, name)
    if not values:
        raise HubctlError(f"hub {name} does not exist")
    if not cfg.gateway_enabled or not gateway_installed(kube):
        raise HubctlError(f"no {GATEWAY} to issue tokens: set a vendor key in .env, keep LLM_GATEWAY on, run hubctl init")
    use_gateway_token(values, issue_gateway_token(kube, name))
    kube.apply(hub_manifests(cfg, name, values))
    kube.rollout_restart(f"hub-{name}", NS_HUBS)
    ready = kube.rollout_status(f"hub-{name}", NS_HUBS)
    print(f"hub {name} restarted with a new gateway token ({'ready' if ready else 'not ready yet'}); the old token is refused")
    return 0 if ready else 1


def cmd_usage(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    cfg.require()
    if not gateway_installed(kube):
        raise HubctlError(f"no {GATEWAY} in the cluster; hubctl init deploys it when .env has a vendor key "
                          "and LLM_GATEWAY is not off")
    cli = ["usage"]
    if args.name:
        cli += ["--hub", validate_name(args.name)]
    if args.since:
        cli += ["--from", args.since]
    if args.until:
        cli += ["--to", args.until]
    rows = json.loads(gateway_cli(kube, *cli).stdout or "[]")
    if not rows:
        print("no usage recorded")
        return 0
    print(f"{'day':<10}  {'hub':<24} {'requests':>8} {'input':>10} {'output':>10} {'cents':>8}")
    for r in rows:
        print(f"{r['day']:<10}  {r['hub']:<24} {r['requests']:>8} {r['input_tokens']:>10} "
              f"{r['output_tokens']:>10} {r['cost_cents']:>8.2f}")
    total = lambda field: sum(r[field] for r in rows)  # noqa: E731
    print(f"{'total':<10}  {'':<24} {total('requests'):>8} {total('input_tokens'):>10} "
          f"{total('output_tokens'):>10} {total('cost_cents'):>8.2f}")
    return 0


def login_url(cfg: Config, name: str, key: str) -> Tuple[str, int]:
    token, expires = mint_magic_token(key)
    return f"{cfg.public_url(name)}/api/v1/auth/magic?token={token}", expires


def cmd_login_link(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    cfg.require()
    key = hub_values(cfg, kube, name).get("NODE_API_KEY")
    if not key:
        raise HubctlError(f"hub {name} does not exist")
    url, expires = login_url(cfg, name, key)
    print(url)
    print(f"valid until {fmt_time(expires)}, single use, accepted by hubs with RN-73 or later")
    return 0


def cmd_backup(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    cfg.require()
    hubs = "" if args.name == "all" else validate_name(args.name)
    cron = kube.get("cronjob", "hub-backup", NS_SYSTEM)
    if cron is None:
        raise HubctlError("the backup CronJob is not installed; run hubctl init first")
    spec = json.loads(json.dumps(cron["spec"]["jobTemplate"]["spec"]))
    pod = spec["template"]["spec"]
    for container in pod.get("initContainers", []) + pod.get("containers", []):
        env = [e for e in container.get("env", []) if e.get("name") != "HUBS"]
        env.append({"name": "HUBS", "value": hubs})
        container["env"] = env
    job_name = f"hub-backup-manual-{utc_stamp().lower()}-{secrets.token_hex(2)}"
    job = {
        "apiVersion": "batch/v1", "kind": "Job",
        "metadata": meta(job_name, NS_SYSTEM, {"app": "hub-backup"}, {"cronjob.kubernetes.io/instantiate": "manual"}),
        "spec": spec,
    }
    kube.apply([job])
    print(f"started job {job_name}")
    done = kube.wait("condition=complete", f"job/{job_name}", NS_SYSTEM, args.timeout)
    print(kube.logs(f"job/{job_name}", NS_SYSTEM).rstrip())
    if not done:
        print(f"job {job_name} did not complete within {args.timeout}; kubectl -n {NS_SYSTEM} describe job/{job_name}", file=sys.stderr)
        return 1
    return 0


def cmd_restore(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    cfg.require()
    archive = Path(args.archive)
    if not archive.exists():
        raise HubctlError(f"{archive} does not exist")
    with zipfile.ZipFile(archive) as zf:
        members = zf.namelist()
    for member in members:
        p = Path(member)
        if p.is_absolute() or ".." in p.parts:
            raise HubctlError(f"{archive} contains an unsafe path {member!r}")
    if "recipes.db" not in members:
        raise HubctlError(f"{archive} has no recipes.db; is it a hub backup?")
    if not hub_values(cfg, kube, name):
        raise HubctlError(f"hub {name} does not exist; create it first, then restore into it")
    sts = f"hub-{name}"
    pod = f"hub-{name}-restore"
    kube.scale(sts, NS_HUBS, 0)
    kube.rollout_status(sts, NS_HUBS, "120s")
    kube.apply([restore_pod(name)])
    kube.wait("condition=Ready", f"pod/{pod}", NS_HUBS, "120s")
    try:
        kube.cp(archive, pod, "/tmp/restore.zip", NS_HUBS)
        kube.exec(pod, NS_HUBS, "sh", "-c",
                  f"rm -rf /data/* && unzip -o /tmp/restore.zip -d /data >/dev/null && chown -R {HUB_UID}:{HUB_UID} /data && ls /data")
    finally:
        kube.delete("pod", pod, NS_HUBS)
    kube.scale(sts, NS_HUBS, 1)
    ready = kube.rollout_status(sts, NS_HUBS)
    print(f"hub {name} restored from {archive.name} ({'ready' if ready else 'not ready yet'})")
    return 0 if ready else 1


def cmd_upgrade(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    cfg.require()
    everything = args.name in (None, "all")
    targets = hub_names(kube) if everything else [validate_name(args.name)]
    failed = []
    if everything and gateway_installed(kube):
        kube.set_image(GATEWAY, NS_SYSTEM, cfg.hub_image, kind="deployment", container="gateway")
        ready = kube.rollout_status(GATEWAY, NS_SYSTEM, kind="deployment")
        print(f"{GATEWAY}: {'ready' if ready else 'not ready'} on {cfg.hub_image}")
        if not ready:
            failed.append(GATEWAY)
    if not targets:
        print("no hubs to upgrade")
        return 1 if failed else 0
    for name in targets:
        kube.set_image(f"hub-{name}", NS_HUBS, cfg.hub_image)
        ready = kube.rollout_status(f"hub-{name}", NS_HUBS)
        print(f"{name}: {'ready' if ready else 'not ready'} on {cfg.hub_image}")
        if not ready:
            failed.append(name)
    return 1 if failed else 0


def cmd_render(cfg: Config, kube: Kube, args: argparse.Namespace) -> int:
    if args.reference:
        out_dir = Path(args.reference)
        out_dir.mkdir(parents=True, exist_ok=True)
        for filename, text in reference_manifests(Config.example()).items():
            (out_dir / filename).write_text(text)
            print(f"wrote {out_dir / filename}")
        return 0
    cfg.require()
    if args.name == "all":
        objects = namespaces() + network_policies() + traefik_config(cfg) + backup_manifests(cfg)
        if cfg.gateway_enabled:
            objects += gateway_manifests(cfg, cfg.gateway_placeholder_env())
    else:
        name = validate_name(args.name)
        values = hub_values(cfg, kube, name) or placeholder_values(cfg, name)
        objects = hub_manifests(cfg, name, values)
    if args.json:
        print(json.dumps({"apiVersion": "v1", "kind": "List", "items": objects}, indent=2))
    else:
        sys.stdout.write(yaml_documents(objects))
    return 0


