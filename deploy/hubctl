            "apiVersion": "v1", "kind": "ConfigMap",
            "metadata": meta("hub-backup-script", NS_SYSTEM),
            "data": {"fetch.sh": FETCH_SCRIPT, "upload.sh": UPLOAD_SCRIPT},
        },
        {
            "apiVersion": "batch/v1", "kind": "CronJob",
            "metadata": meta("hub-backup", NS_SYSTEM),
            "spec": {
                "schedule": cfg.backup_schedule,
                "concurrencyPolicy": "Forbid",
                "successfulJobsHistoryLimit": 3,
                "failedJobsHistoryLimit": 3,
                "jobTemplate": {"spec": {
                    "backoffLimit": 1,
                    "template": {
                        "metadata": {"labels": {"app": "hub-backup", "role": "hub-client"}},
                        "spec": {
