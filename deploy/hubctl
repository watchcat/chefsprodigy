class HubctlError(Exception):
    """A user-facing error: printed as one line, exit status 2."""


# ----------------------------------------------------------------------------- helpers


def validate_name(name: str) -> str:
    if not NAME_RE.match(name or ""):
        raise HubctlError(
            f"{name!r} is not a valid hub name: lowercase letters, digits and hyphens, "
            "1-63 characters, no leading or trailing hyphen"
        )
    if name in RESERVED_NAMES:
        raise HubctlError(f"{name!r} is reserved and cannot be a hub name")
    return name


def read_env_file(path: Path) -> Dict[str, str]:
    values: Dict[str, str] = {}
    if not path.exists():
        return values
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[key.strip()] = value
    return values


def utc_stamp() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def fmt_time(epoch: int) -> str:
    return dt.datetime.fromtimestamp(epoch, dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def mint_magic_token(key: str, now: Optional[float] = None) -> Tuple[str, int]:
    """`<expires>.<nonce>.<mac>` (spec 4.6); the HMAC key is the NODE_API_KEY string."""
    expires = int((now if now is not None else time.time()) + MAGIC_TTL_SECONDS)
    nonce = secrets.token_hex(8)
    mac = hmac.new(key.encode(), f"{MAGIC_PREFIX}{expires}:{nonce}".encode(), hashlib.sha256).hexdigest()
    return f"{expires}.{nonce}.{mac}", expires


def secret_values(secret: Optional[dict]) -> Dict[str, str]:
    """Plain values of a Secret, whether it came back as `data` (base64) or `stringData`."""
    if not secret:
        return {}
    values = dict(secret.get("stringData") or {})
    for k, v in (secret.get("data") or {}).items():
        values.setdefault(k, base64.b64decode(v).decode())
    return values


def meta(name: str, namespace: Optional[str], labels: Optional[Dict[str, str]] = None, annotations: Optional[Dict[str, str]] = None) -> dict:
    m: dict = {"name": name}
    if namespace:
        m["namespace"] = namespace
    if labels:
        m["labels"] = labels
    if annotations:
        m["annotations"] = annotations
    return m


# ----------------------------------------------------------------------------- yaml

_PLAIN_SCALAR = re.compile(r"^[A-Za-z_/][A-Za-z0-9_./-]*$")
_YAML_RESERVED = {"true", "false", "yes", "no", "on", "off", "null", "y", "n", "~"}


def _yaml_scalar(value) -> str:
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, (int, float)):
        return str(value)
    text = str(value)
    if _PLAIN_SCALAR.match(text) and text.lower() not in _YAML_RESERVED:
        return text
    return json.dumps(text, ensure_ascii=False)  # a JSON string is a valid YAML double-quoted scalar


def _yaml_block(text: str, indent: int) -> Tuple[str, List[str]]:
    """Literal block scalar: header (`|`, `|-`, `|+`, with an indentation indicator when the
    first line starts with a space) and the indented lines."""
    if text.endswith("\n\n"):
        chomp, body = "+", text[:-1]
    elif text.endswith("\n"):
        chomp, body = "", text[:-1]
    else:
        chomp, body = "-", text
    lines = body.split("\n")
    indicator = "2" if lines and lines[0].startswith(" ") else ""
    pad = " " * indent
    return f"|{indicator}{chomp}", [f"{pad}{line}" if line else "" for line in lines]


def _yaml_emit(value, indent: int, out: List[str]) -> None:
    pad = " " * indent
    if isinstance(value, dict):
        for key, item in value.items():
            k = _yaml_scalar(str(key))
            if isinstance(item, dict) and item:
                out.append(f"{pad}{k}:")
                _yaml_emit(item, indent + 2, out)
            elif isinstance(item, list) and item:
                out.append(f"{pad}{k}:")
                _yaml_emit(item, indent + 2, out)
            elif isinstance(item, dict):
                out.append(f"{pad}{k}: {{}}")
            elif isinstance(item, list):
                out.append(f"{pad}{k}: []")
            elif isinstance(item, str) and "\n" in item:
                header, lines = _yaml_block(item, indent + 2)
                out.append(f"{pad}{k}: {header}")
                out.extend(lines)
            else:
                out.append(f"{pad}{k}: {_yaml_scalar(item)}")
        return
    for item in value:
        if isinstance(item, (dict, list)) and item:
            sub: List[str] = []
            _yaml_emit(item, indent + 2, sub)
            sub[0] = f"{pad}- {sub[0][indent + 2:]}"
            out.extend(sub)
        elif isinstance(item, dict):
            out.append(f"{pad}- {{}}")
        elif isinstance(item, list):
            out.append(f"{pad}- []")
        elif isinstance(item, str) and "\n" in item:
            header, lines = _yaml_block(item, indent + 2)
            out.append(f"{pad}- {header}")
            out.extend(lines)
        else:
            out.append(f"{pad}- {_yaml_scalar(item)}")


def to_yaml(value) -> str:
    """Render a manifest (JSON-compatible dict or list) as YAML; standard library only."""
    out: List[str] = []
    _yaml_emit(value, 0, out)
    return "\n".join(out) + "\n"


def yaml_documents(objects: List[dict], header: str = "") -> str:
    return header + "---\n".join(to_yaml(obj) for obj in objects)


# ----------------------------------------------------------------------------- config


class Config:
    def __init__(self, root: Path, env: Optional[Dict[str, str]] = None):
        self.root = root
        self.env = read_env_file(root / ".env") if env is None else dict(env)
        e = self.env
        self.domain = e.get("DOMAIN", "").strip().rstrip(".")
        self.hub_image = e.get("HUB_IMAGE", "ghcr.io/watchcat/chefsprodigy:latest")
        self.tls_mode = e.get("TLS_MODE", "origin")
        self.hub_storage = e.get("HUB_STORAGE", "2Gi")
        self.hub_mem_limit = e.get("HUB_MEM_LIMIT", "128Mi")
        self.hub_cpu_limit = e.get("HUB_CPU_LIMIT", "500m")
        self.hub_mem_request = e.get("HUB_MEM_REQUEST", "32Mi")
        self.hub_cpu_request = e.get("HUB_CPU_REQUEST", "50m")
        self.backup_schedule = e.get("BACKUP_SCHEDULE", "17 3 * * *")
        self.r2_bucket = e.get("R2_BUCKET", "")
        self.r2_account_id = e.get("R2_ACCOUNT_ID", "")
        self.r2_access_key_id = e.get("R2_ACCESS_KEY_ID", "")
        self.r2_secret_access_key = e.get("R2_SECRET_ACCESS_KEY", "")
        self.llm_gateway = e.get("LLM_GATEWAY", "on").strip().lower()
        self.gateway_storage = e.get("GATEWAY_STORAGE", "1Gi")
        self.gateway_mem_limit = e.get("GATEWAY_MEM_LIMIT", "64Mi")

    def require(self) -> None:
        env_path = self.root / ".env"
        if not env_path.exists():
            raise HubctlError(f"{env_path} is missing; copy deploy/env.example there and fill it in")
        if not self.domain:
            raise HubctlError(f"DOMAIN is not set in {env_path}")
        if self.tls_mode not in ("origin", "off"):
            raise HubctlError("TLS_MODE must be 'origin' (Cloudflare Origin CA) or 'off' (local tests)")

    @property
    def tls(self) -> bool:
        return self.tls_mode == "origin"

    @property
    def scheme(self) -> str:
        return "https" if self.tls else "http"

    @property
    def r2_configured(self) -> bool:
        return bool(self.r2_bucket and self.r2_account_id and self.r2_access_key_id and self.r2_secret_access_key)

    @property
    def gateway_enabled(self) -> bool:
        """The gateway runs when .env holds a vendor key it can serve, unless LLM_GATEWAY=off."""
        return self.llm_gateway != "off" and any(self.env.get(k) for k in GATEWAY_VENDOR_KEYS)

    def gateway_env(self) -> Dict[str, str]:
        return {k: self.env[k] for k in GATEWAY_ENV_KEYS if self.env.get(k)}

    def gateway_placeholder_env(self) -> Dict[str, str]:
        """The gateway Secret as `render` shows it: vendor keys and the admin token masked."""
        masked = set(GATEWAY_VENDOR_KEYS) | {"GATEWAY_ADMIN_TOKEN"}
        return {k: (GATEWAY_PLACEHOLDER if k in masked else v) for k, v in self.gateway_env().items()}

    @classmethod
    def example(cls) -> "Config":
        """Production-shaped settings for the reference manifests in deploy/k8s (no secrets)."""
        return cls(Path(DEFAULT_ROOT), {
            "DOMAIN": "chefslegacy.com",
            "HUB_IMAGE": "ghcr.io/watchcat/chefsprodigy:latest",
            "TLS_MODE": "origin",
            "LLM_MODEL": "minimax/MiniMax-M3",
            "MINIMAX_API_KEY": GATEWAY_PLACEHOLDER,
        })

    def host(self, name: str) -> str:
        return f"{name}.{self.domain}"

    def public_url(self, name: str) -> str:
        return f"{self.scheme}://{self.host(name)}"


# ----------------------------------------------------------------------------- kubectl


class Kube:
    """`kubectl` with the k3s kubeconfig; HUBCTL_KUBECTL swaps the binary (tests)."""

    def __init__(self) -> None:
        self.binary = os.environ.get("HUBCTL_KUBECTL", "kubectl")
        self.env = dict(os.environ)
        if "KUBECONFIG" not in self.env and Path(K3S_KUBECONFIG).exists():
            self.env["KUBECONFIG"] = K3S_KUBECONFIG

    def run(self, *args: str, stdin: Optional[str] = None, check: bool = True) -> subprocess.CompletedProcess:
        return subprocess.run(
            [self.binary, *args], input=stdin, text=True, capture_output=True, check=check, env=self.env
        )

    def apply(self, objects: List[dict], namespace: Optional[str] = None) -> None:
        if not objects:
            return
        doc = json.dumps({"apiVersion": "v1", "kind": "List", "items": objects})
        args = ["apply", "-f", "-"]
        if namespace:
            args += ["-n", namespace]
        self.run(*args, stdin=doc)

    def get(self, kind: str, name: str, namespace: str) -> Optional[dict]:
        result = self.run("get", kind, name, "-n", namespace, "-o", "json", check=False)
        if result.returncode != 0:
            return None
        return json.loads(result.stdout)

    def list(self, kind: str, namespace: str, selector: Optional[str] = None) -> List[dict]:
        args = ["get", kind, "-n", namespace]
        if selector:
            args += ["-l", selector]
        args += ["-o", "json"]
        result = self.run(*args, check=False)
        if result.returncode != 0:
            return []
        return json.loads(result.stdout).get("items", [])

    def delete(self, kind: str, name: str, namespace: str) -> None:
        self.run("delete", kind, name, "-n", namespace, "--ignore-not-found")

    def scale(self, statefulset: str, namespace: str, replicas: int) -> None:
        self.run("scale", f"statefulset/{statefulset}", "-n", namespace, f"--replicas={replicas}")

    def rollout_status(self, name: str, namespace: str, timeout: str = "180s", kind: str = "statefulset") -> bool:
        result = self.run("rollout", "status", f"{kind}/{name}", "-n", namespace, f"--timeout={timeout}", check=False)
        return result.returncode == 0

    def rollout_restart(self, name: str, namespace: str, kind: str = "statefulset") -> None:
        self.run("rollout", "restart", f"{kind}/{name}", "-n", namespace)

    def set_image(self, name: str, namespace: str, image: str, kind: str = "statefulset", container: str = "node") -> None:
        self.run("set", "image", f"{kind}/{name}", f"{container}={image}", "-n", namespace)

    def pods(self, namespace: str, selector: str) -> List[dict]:
        return self.list("pods", namespace, selector)

    def wait(self, condition: str, target: str, namespace: str, timeout: str) -> bool:
        result = self.run("wait", f"--for={condition}", target, "-n", namespace, f"--timeout={timeout}", check=False)
        return result.returncode == 0

    def logs(self, target: str, namespace: str) -> str:
        result = self.run("logs", target, "-n", namespace, "--all-containers=true", check=False)
        return (result.stdout or "") + (result.stderr or "")

    def cp(self, local: Path, pod: str, remote: str, namespace: str) -> None:
        self.run("cp", str(local), f"{namespace}/{pod}:{remote}")

    def exec(self, pod: str, namespace: str, *command: str) -> str:
        return self.run("exec", pod, "-n", namespace, "--", *command).stdout


# ----------------------------------------------------------------------------- manifests


def namespaces() -> List[dict]:
    return [
        {"apiVersion": "v1", "kind": "Namespace", "metadata": meta(NS_SYSTEM, None)},
        {"apiVersion": "v1", "kind": "Namespace", "metadata": meta(NS_HUBS, None)},
    ]


def network_policies() -> List[dict]:
    """Default deny in chefs-hubs; hubs accept Traefik and chefs-system hub clients
    (platform poller, backup job) and reach DNS, public addresses and the gateway."""
    ns = lambda name: {"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": name}}}  # noqa: E731
    return [
        {
            "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
            "metadata": meta("default-deny", NS_HUBS),
            "spec": {"podSelector": {}, "policyTypes": ["Ingress", "Egress"]},
        },
        {
            "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
            "metadata": meta("hub-ingress", NS_HUBS),
            "spec": {
                "podSelector": {"matchLabels": {"app": "hub"}},
                "policyTypes": ["Ingress"],
                "ingress": [{
                    "from": [
                        ns(NS_TRAEFIK),
                        {**ns(NS_SYSTEM), "podSelector": {"matchLabels": {"role": "hub-client"}}},
                    ],
                    "ports": [{"protocol": "TCP", "port": 8080}],
                }],
            },
        },
        {
            "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
            "metadata": meta("hub-egress", NS_HUBS),
            "spec": {
                "podSelector": {"matchLabels": {"app": "hub"}},
                "policyTypes": ["Egress"],
                "egress": [
                    {
                        "to": [{**ns(NS_TRAEFIK), "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}}],
                        "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}],
                    },
                    {"to": [{"ipBlock": {"cidr": "0.0.0.0/0", "except": PRIVATE_RANGES}}]},
                    {
                        "to": [{**ns(NS_SYSTEM), "podSelector": {"matchLabels": {"app": "llm-gateway"}}}],
                        "ports": [{"protocol": "TCP", "port": 8080}],
                    },
                ],
            },
        },
    ]


def traefik_config(cfg: Config) -> List[dict]:
    ranges = "\n".join(f"        - {r}" for r in CLOUDFLARE_RANGES)
    redirect = ""
    if cfg.tls:
        redirect = (
            "  web:\n"
            "    redirections:\n"
            "      entryPoint:\n"
            "        to: websecure\n"
            "        scheme: https\n"
        )
    values = (
        "# Rendered by hubctl: Cloudflare fronts every hostname.\n"
        "ports:\n"
        f"{redirect}"
        "  websecure:\n"
        "    forwardedHeaders:\n"
        "      trustedIPs:\n"
        f"{ranges}\n"
        "logs:\n"
        "  access:\n"
        "    enabled: false\n"
    )
    objects = [
        {
            "apiVersion": "helm.cattle.io/v1", "kind": "HelmChartConfig",
            "metadata": meta("traefik", NS_TRAEFIK),
            "spec": {"valuesContent": values},
        },
        {
            "apiVersion": "traefik.io/v1alpha1", "kind": "Middleware",
            "metadata": meta("headers", NS_SYSTEM),
            "spec": {"headers": {"frameDeny": True, "contentTypeNosniff": True, "referrerPolicy": "strict-origin-when-cross-origin"}},
        },
    ]
    if cfg.tls:
        objects.append({
            "apiVersion": "traefik.io/v1alpha1", "kind": "TLSStore",
            "metadata": meta("default", NS_TRAEFIK),
            "spec": {"defaultCertificate": {"secretName": ORIGIN_TLS_SECRET}},
        })
    return objects


def backup_manifests(cfg: Config) -> List[dict]:
    mounts = [{"name": "work", "mountPath": "/work"}, {"name": "scripts", "mountPath": "/scripts"}]
    objects = [
        {"apiVersion": "v1", "kind": "ServiceAccount", "metadata": meta("hub-backup", NS_SYSTEM)},
        {
            "apiVersion": "rbac.authorization.k8s.io/v1", "kind": "Role",
            "metadata": meta("hub-secrets-reader", NS_HUBS),
            "rules": [{"apiGroups": [""], "resources": ["secrets"], "verbs": ["get", "list"]}],
