# Rendered by hubctl into <root>/caddy/Caddyfile; edit deploy/templates/Caddyfile.tmpl instead.
# caddy-docker-proxy appends one site per hub from the labels in compose.hubs.yml.
{
    # Cloudflare fronts every hostname: trust its ranges so the client IP is the visitor's.
    servers {
        trusted_proxies static $cloudflare_ranges
        client_ip_headers CF-Connecting-IP
    }
$global_extra
}

# Imported by every hub route (label caddy.import: hub_common) and by the apex.
(hub_common) {
$tls_directive
    # Cloudflare's own cap is 100 MB on the free plan; stay just above it.
    request_body {
        max_size 110MB
    }
    # Access log to stdout without magic-link tokens.
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
            }
        }
    }
}

# The apex: the platform's search page later (RN-70); a placeholder until then.
$apex_site {
    import hub_common
    respond "Chef's Prodigy. Hubs live at <name>.$domain." 200
}
