# Only what the build needs reaches the daemon: manifests, crates, migrations and the
# embedded frontend. Everything else would just slow the context upload or leak secrets.
target/
data/
.git/
.github/
.claude/
.work/
.manus/
tasks/
inputs/
docs/
scripts/
examples/
deploy/
*.md
.env
.env.*
cookies.txt
*.db
*.db-wal
*.db-shm
.DS_Store
# The image's pinned toolchain is used instead of the "stable" channel named here.
rust-toolchain.toml
