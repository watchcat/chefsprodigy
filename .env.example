# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# devbuild.sh loads this file automatically. For a plain `node-server serve`,
# run `set -a; source .env; set +a` first.

# --- LLM for ingredient normalization and free-text import (optional)
# rig catalog reference, vendor/model. Examples:
#   minimax/MiniMax-M3     minimax/MiniMax-M2.5   anthropic/claude-haiku-4-5
#   openai/gpt-5-mini      ollama/llama3.2 (local, no key)
LLM_MODEL=minimax/MiniMax-M3
# Vendor key, in the vendor's own variable. LLM_API_KEY is a generic override, but when it
# is set no other vendor variable (such as an endpoint override) is read.
MINIMAX_API_KEY=
# MiniMax China-mainland endpoint (default is the international api.minimax.io):
#MINIMAX_ANTHROPIC_API_BASE=https://api.minimaxi.com/anthropic
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#LLM_API_KEY=

# --- MCP over HTTP (optional). Unset keeps /mcp disabled; stdio mode needs no key.
NODE_API_KEY=

# --- Node identity and server settings (optional)
#NODE_PORT=8080
#NODE_HOST=0.0.0.0
#NODE_DATA_DIR=data
#NODE_CHEF_NAME=Chef
#NODE_AUTHOR_DID=
#NODE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
#RUST_LOG=info,tower_http=info
